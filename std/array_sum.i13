// std/array_sum.i13 -- sum of a bounded array, by recursion over an explicit length.
// Demonstrates the array literal, indexed read, and value-passing of an array to a function.
def sum(I arr, I i, I n) {
  if i >= n { -> 0 }
  -> arr[i] + sum(arr, i + 1, n)
}
I total <- sum([3, 1, 4, 1, 5, 9, 2, 6], 0, 8)   // 31
