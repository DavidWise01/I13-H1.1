def point_ok(I x, I y, I ex, I ey) {
    if x == ex {
        if y == ey { -> 1 }
    }
    -> 0
}

def relation_cycle() {
    if point_ok(0, 0, 0, 0) != 1 { -> 0 }
    if point_ok(0, 1, 0, 1) != 1 { -> 0 }
    if point_ok(0, -1, 0, -1) != 1 { -> 0 }
    if point_ok(-1, 0, -1, 0) != 1 { -> 0 }
    if point_ok(1, 0, 1, 0) != 1 { -> 0 }
    if point_ok(0, 0, 0, 0) != 1 { -> 0 }
    -> 1
}

def river_selftest() {
    if RIVER_START != 196418 { -> 0 }
    if R0_OUT != 317811 { -> 0 }
    if R1_IN != R0_OUT { -> 0 }
    if R1_OUT != 514229 { -> 0 }
